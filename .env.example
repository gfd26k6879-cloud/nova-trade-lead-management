# Supabase Postgres. Use the Supabase transaction pooler URI in Vercel.
DATABASE_URL=postgresql://postgres.project:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Google Places API (New) - required for lead discovery and enrichment.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Supabase Auth. Use the Project URL, publishable key, and service_role key from Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NOSITE_BOOTSTRAP_ADMIN_EMAIL=you@example.com
NOSITE_ENCRYPTION_SECRET=replace_with_at_least_32_random_characters

# OpenAI lead verification. The app refuses any model other than gpt-5.4-mini.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini
OPENAI_AI_COST_RESERVATION_USD=0.05

# AI cost guardrail defaults exposed in Settings.
AI_DAILY_BUDGET_USD=2
AI_MONTHLY_BUDGET_USD=25
AI_BATCH_LIMIT=25
AI_CACHE_TTL_DAYS=30
