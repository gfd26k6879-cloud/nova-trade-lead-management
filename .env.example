# Supabase Postgres. Use the Supabase transaction pooler URI in Vercel.
DATABASE_URL=postgresql://postgres.project:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_MAX_CONNECTIONS=1

# Google Places API (New) - required for lead discovery and enrichment.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Optional Google Maps JavaScript API key for the Explorer's opt-in browser map.
# Restrict this key by HTTP referrer in Google Cloud and set a low quota/budget.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=your_browser_restricted_google_maps_key_here

# Supabase Auth. Use the Project URL, publishable key, and service_role key from Supabase.
NEXT_PUBLIC_APP_URL=https://www.nosite.xyz
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NOSITE_BOOTSTRAP_ADMIN_EMAIL=you@example.com
NOSITE_ENCRYPTION_SECRET=replace_with_at_least_32_random_characters
WORKER_CRON_SECRET=replace_with_a_random_secret_also_saved_in_supabase_vault
WORKER_ROUTE_TIMEOUT_MS=45000

# OpenAI lead verification. The app refuses any model other than gpt-5.4-mini.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini
OPENAI_AI_COST_RESERVATION_USD=0.05

# Worker lease roles (L-01). The issuer acquires durable leases and the
# resolver authorizes the five worker routes; each connection uses its own
# restricted role. `npm run local:seed` provisions the roles on loopback
# PostgreSQL (including local Supabase at 127.0.0.1:54322) and prints the
# exact URLs to copy here. Missing or malformed configuration fails closed.
TENANT_WORKER_LEASE_ISSUER_DATABASE_URL=postgresql://novatrade_worker_lease_issuer:replace_me@127.0.0.1:54322/postgres
TENANT_WORKER_LEASE_RESOLVER_DATABASE_URL=postgresql://novatrade_worker_lease_resolver:replace_me@127.0.0.1:54322/postgres

# L-01 local runtime seeding (scripts/seed-local-tenant.mjs). Passwords default
# to generated values printed once by the seed. LOCAL_SEED_ALLOW_REMOTE=1 is
# required to seed any non-loopback database; keep this unset for local use.
# LOCAL_ADMIN_PASSWORD=replace_me_or_leave_generated
# LOCAL_RESEARCHER_PASSWORD=replace_me_or_leave_generated
# LOCAL_WORKER_LEASE_ISSUER_PASSWORD=replace_me_or_leave_generated
# LOCAL_WORKER_LEASE_RESOLVER_PASSWORD=replace_me_or_leave_generated
# LOCAL_TENANT_SLUG=local-demo
# LOCAL_ADMIN_EMAIL=admin@local.nosite.test
# LOCAL_RESEARCHER_EMAIL=researcher@local.nosite.test

# AI cost guardrail defaults exposed in Settings.
AI_DAILY_BUDGET_USD=2
AI_MONTHLY_BUDGET_USD=25
AI_BATCH_LIMIT=25
AI_CACHE_TTL_DAYS=30
